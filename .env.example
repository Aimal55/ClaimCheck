# ── Application ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in values.  Never commit .env to git.

# FastAPI server
APP_HOST=127.0.0.1
APP_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# SQLite database file path (relative to project root)
DB_PATH=claimcheck.db

# Claim length limits
CLAIM_MIN_LENGTH=10
CLAIM_MAX_LENGTH=2000

# Streamlit → API base URL (used by frontend/app.py)
API_BASE_URL=http://127.0.0.1:8000

# ── Gemini atomic claim decomposition and evidence verdicts ─────────────
# Create an API key in Google AI Studio and keep it private in .env.
GEMINI_API_KEY=
# Confirm availability for your account; change this if the model is not enabled.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Live search (Tavily key required) ────────────────────────────────
SEARCH_PROVIDER=tavily
# Obtain a Tavily key only if SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=
SEARCH_RESULT_LIMIT=8
EXTRACTION_TIMEOUT_SECONDS=12

# ── Retrieval and optional reranking ────────────────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=120
RETRIEVAL_CHUNK_LIMIT=12
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
